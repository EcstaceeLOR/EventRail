{
  "name": "@eventrail/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@eventrail/types": "workspace:*",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": { "@types/node": "26.5.0", "typescript": "7.0.2" }
}
