{
  "name": "eventrail",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial DreamDEX Event Contract infrastructure and trading experience",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm check:repo && pnpm verify:gates",
    "check:repo": "node scripts/check-repository.mjs",
    "commitlint": "node scripts/validate-commit-message.mjs",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "simple-git-hooks",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/test/repository-policy.test.mjs && turbo run test",
    "verify:gates": "node scripts/verify-quality-gates.mjs",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.14.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check:repo",
    "commit-msg": "pnpm commitlint \"$1\""
  }
}
