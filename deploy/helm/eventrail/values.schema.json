{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["environment", "releaseVersion", "image", "runtimeSecretName", "components"],
  "properties": {
    "environment": { "enum": ["preview", "staging", "production"] },
    "releaseVersion": { "type": "string", "minLength": 7 },
    "runtimeSecretName": { "type": "string", "pattern": "^eventrail-(preview|staging|production)-runtime$" },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    }
  }
}
